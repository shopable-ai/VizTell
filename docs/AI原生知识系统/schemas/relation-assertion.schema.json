{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:viztell:ai-knowledge-system:schema:relation-assertion:0.1",
  "title": "Relation Assertion v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["relation_id", "subject_id", "relation_type", "object_id", "adjudication_status"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "relation_id": {"type": "string", "pattern": "^R-.+"},
    "subject_id": {"type": "string", "minLength": 1},
    "relation_type": {
      "enum": ["alias_of", "broader_than", "narrower_than", "related_to", "overlaps_with", "equivalent_to", "paraphrase_of", "contains", "refines", "adds_condition", "adds_boundary", "adds_scope", "adds_mechanism", "supports", "weakens", "conflicts_with", "counterexample_to", "derived_from", "quoted_from", "revision_of", "alternate_representation_of", "has_primary_source", "supersedes", "prerequisite_of", "depends_on", "complements", "substitutes_for", "implemented_by", "unrelated", "uncertain_pending_review"]
    },
    "object_id": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^E-.+"}, "uniqueItems": true},
    "rationale": {"type": ["string", "null"]},
    "adjudication_status": {"enum": ["candidate", "confirmed", "rejected", "superseded", "pending_review"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "created_by": {"type": ["string", "null"]},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "supersedes_relation_id": {"type": ["string", "null"], "pattern": "^R-.+"}
  },
  "allOf": [
    {
      "not": {
        "properties": {
          "subject_id": {"const": ""},
          "object_id": {"const": ""}
        },
        "required": ["subject_id", "object_id"]
      }
    }
  ]
}